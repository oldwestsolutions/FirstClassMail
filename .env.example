# Public URLs — set in Vercel (or copy to .env.local for local).
# Subdomain apps: must match domains added in Vercel → Project → Settings → Domains
# (e.g. CNAME campaign → cname.vercel-dns.com). Rewrites in next.config.js use these hostnames.

NEXT_PUBLIC_CAMPAIGN_URL=https://campaign.firstclassmail.xyz
NEXT_PUBLIC_ADMIN_URL=https://admin.firstclassmail.xyz
NEXT_PUBLIC_MAIN_SITE_URL=https://firstclassmail.xyz
